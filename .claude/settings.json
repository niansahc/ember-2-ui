{
  "permissions": {
    "deny": [
      "Bash(git commit *--no-v*)",
      "Bash(git * commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -an*)",
      "Bash(git commit -sn*)",
      "Bash(git commit * -sn*)",
      "Bash(git commit -vn*)",
      "Bash(git commit * -vn*)",
      "Bash(git commit -qn*)",
      "Bash(git commit * -qn*)",
      "Bash(git commit -en*)",
      "Bash(git commit * -en*)",
      "Bash(git * commit -n*)",
      "Bash(git * commit * -n*)",
      "PowerShell(git commit *--no-v*)",
      "PowerShell(git * commit *--no-v*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git commit -an*)",
      "PowerShell(git commit * -an*)",
      "PowerShell(git commit -sn*)",
      "PowerShell(git commit * -sn*)",
      "PowerShell(git commit -vn*)",
      "PowerShell(git commit * -vn*)",
      "PowerShell(git commit -qn*)",
      "PowerShell(git commit * -qn*)",
      "PowerShell(git commit -en*)",
      "PowerShell(git commit * -en*)",
      "PowerShell(git * commit -n*)",
      "PowerShell(git * commit * -n*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const p=JSON.parse(d).tool_input.file_path||'';if(/(\\\\|\\/|^)\\.env/.test(p)){console.log(JSON.stringify({decision:'block',reason:'Edits to .env files are blocked by hook policy.'}))}else{console.log(JSON.stringify({continue:true}))}})\"",
            "timeout": 5,
            "statusMessage": "Checking file policy..."
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-reads.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking .env read policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const p=JSON.parse(d).tool_input.file_path||'';if(/\\.(jsx|js|css)$/.test(p)&&/^src[\\\\\\/]/.test(p)){process.exit(0)}else{process.exit(1)}})\" && powershell.exe -Command \"npx playwright test --workers=2\" 2>/dev/null || true",
            "timeout": 300,
            "async": true,
            "statusMessage": "Running Playwright tests..."
          }
        ]
      }
    ]
  }
}
